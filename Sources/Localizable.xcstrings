            "state": "translated",
            "value": "使用中"
          }
        }
      }
    },
    "Ensure Antigravity IDE is running to read this account.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先运行 Antigravity IDE，才能读取此账号。"

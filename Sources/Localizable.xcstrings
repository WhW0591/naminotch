            "state": "translated",
            "value": "10 秒"
          }
        }
      }
    },
    "Long enough to notice, short enough to ignore.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "够注意到，也够被忽略。"
          }
        }
      }
    },
    "Long enough to read the session's name and reach for it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "够读完会话名称并伸手过去。"

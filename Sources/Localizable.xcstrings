      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "5-Hour Limit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {

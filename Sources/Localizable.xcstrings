    "Minutes under an hour; otherwise the reset date and time.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不足一小时显示分钟；否则显示重置日期和时间。"
          }
        }
      }
    },
    "Time until usage resets, such as 3 Days 3h or 3h 20m.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离用量重置还有多久，例如 3 Days 3h 或 3h 20m。"
          }
        }
      }
    },
    "Resets in %lld Day %lldh": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天 %lld 小时后重置"
          }
        }
      }
    },
    "Resets in %lld Days %lldh": {
      "extractionState": "manual",

    },
    "The notch opens for a moment or shows a card, with the sound you chose. Nothing reaches Notification Center.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海会短暂打开，或显示一张卡片，并播放你选的声音。不会进通知中心。"
          }
        }
      }
    },
    "This is what one looks like.": {
      "extractionState": "manual",

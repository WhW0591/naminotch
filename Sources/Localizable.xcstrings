        }
      }
    },
    "Sign in with the Command Code app to read your usage": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Command Code 应用登录以读取用量"
